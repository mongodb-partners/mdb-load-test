        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build 1024-dim query vector">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">int dim = Integer.parseInt(vars.get(&quot;VECTOR_DIM&quot;));
int limit = Integer.parseInt(vars.get(&quot;SEARCH_LIMIT&quot;));
int numCandidates = Integer.parseInt(vars.get(&quot;SEARCH_NUM_CANDIDATES&quot;));
java.util.Random r = new java.util.Random();
StringBuilder sb = new StringBuilder(dim * 10);
sb.append(&apos;{&quot;vector&quot;:[&apos;);
for (int i = 0; i &lt; dim; i++) {
  if (i &gt; 0) sb.append(&apos;,&apos;);
  sb.append(String.format(&quot;%.6f&quot;, r.nextGaussian()));
}
sb.append(&apos;],&quot;limit&quot;:&apos;).append(limit).append(&apos;,&quot;numCandidates&quot;:&apos;).append(numCandidates).append(&apos;}&apos;);
vars.put(&quot;SEARCH_BODY&quot;, sb.toString());</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
