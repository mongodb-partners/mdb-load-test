# Copy to deploy/.env.deploy (gitignored) and fill in. deploy.sh sources this.

# Image the benchmark-api cluster can pull. Push here first (docker push).
# Nebius Container Registry example (replace <registry-id>/host with yours):
IMAGE=cr.eu-north1.nebius.cloud/<registry-id>/mdb-load-test:latest

KUBE_CONTEXT=benchmark-api
NAMESPACE=default

# Local path to the MongoDB TLS CA cert (uploaded into the pod as a Secret).
CA_FILE=/home/suresh/ca.pem

# Atlas-issued Voyage model API key -> https://ai.mongodb.com/v1/embeddings.
# Optional at runtime (JMeter sends vectors); REQUIRED when running the seed.
EMBEDDING_API_KEY=al-...

# Full MongoDB connection string. IMPORTANT:
#  - tlsCAFile must point to the in-pod path: /etc/mongo/ca.pem
#  - include a database in the path (…:31713/<database>?authSource=admin…);
#    the sample URI had none, which Spring Data requires.
MONGODB_URI="mongodb://USER:PASSWORD@search-benchmarking-0.external:30481,search-benchmarking-1.external:30640,search-benchmarking-2.external:31713/loadtest?authSource=admin&replicaSet=search-benchmarking&tls=true&tlsCAFile=/etc/mongo/ca.pem&readPreference=secondaryPreferred"
