# Copy to .env and source it (`set -a; . ./.env; set +a`) or export these manually.

# MongoDB Atlas SRV connection string (include the database name in the path).
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/loadtest?retryWrites=true&w=majority"

# Embedding API key.
#   - Atlas-issued (model) key  -> works against https://ai.mongodb.com/v1/embeddings (default)
#   - Key created on voyageai.com -> set EMBEDDING_BASE_URL=https://api.voyageai.com/v1/embeddings
# Required by the SEED (to embed products) and to embed text /search queries at runtime.
EMBEDDING_API_KEY="al-..."
# EMBEDDING_BASE_URL="https://ai.mongodb.com/v1/embeddings"
# EMBEDDING_MODEL="voyage-4"

# Runtime toggle: true = hit MongoDB, false = return canned response after simulated wait.
APP_USE_DB=true
APP_SIMULATED_WAIT_MS=50

# Optional overrides
SERVER_PORT=8080
APP_VECTOR_INDEX=products_vector_index
APP_VECTOR_DIMENSIONS=1024
